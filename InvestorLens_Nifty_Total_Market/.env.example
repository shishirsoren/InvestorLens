# Optional quote source already supported by the app. Keep keys out of public repositories.
FINNHUB_API_KEY=

# Optional alternate constituent CSVs, comma-separated.
UNIVERSE_URLS=

# Live market & industry auto-polling (seconds); observe your provider's limits/terms.
MARKET_POLL_SECONDS=300
MARKET_DATA_WORKERS=8

# CAPM defaults
DEFAULT_RISK_FREE_RATE=6.0
DEFAULT_MARKET_RETURN=12.0
